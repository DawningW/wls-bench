+
+unsigned MPEG2TransportStreamDemuxedTrack::maxFrameSize() const {
+  // Each delivery contains at most one Transport Stream packet's PES payload,
+  // i.e., at most 188-4 = 184 bytes.  We report 2 TS packets' worth so that a
+  // downstream "StreamParser" (e.g., the one inside "H264or5VideoStreamFramer")
+  // always reserves enough bank room for a complete delivery:  // "StreamParser::ensureValidBytes1()" inflates its "numBytesNeeded" to this
+  // value, which makes it swap banks early enough that the buffer it gives us
+  // ("BANK_SIZE - fTotNumValidBytes") is always >= 184 bytes.  If we reported
+  // 0 (the default), the swap would happen too late, and near the end of each
+  // 150KB bank our delivery would get truncated and the excess ES bytes
+  // silently skipBytes()'d by "processStreamPacket()" -> permanent holes in
+  // the elementary stream -> mosaic/tearing on decode.
+  return 2*TRANSPORT_PACKET_SIZE;
+}
