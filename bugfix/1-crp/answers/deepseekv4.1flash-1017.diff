+// Stream packet, i.e. 188 bytes minus its 4-byte header and any adaptation field.
+// Downstream parsers use this value ('FramedSource::maxFrameSize()') to make sure that
+// there is always enough room in their buffer to accept a complete frame; without it they
+// may have to truncate a delivery, which would silently corrupt the byte stream.
+#define DEMUXED_TRACK_MAX_FRAME_SIZE 188
+
