+
+unsigned MPEG2TransportStreamDemuxedTrack::maxFrameSize() const {
+  // The maximum amount of data that the parser will deliver to us in a single read
+  // is the payload of a Transport Stream packet (188 bytes - 4-byte header).
+  // We must tell this to our reader (usually a "StreamParser"), so that it can
+  // ensure that it never has less room than this when it asks us for data.
+  // Otherwise "MPEG2TransportStreamParser::processStreamPacket()" would silently
+  // discard ('skipBytes') the data that doesn't fit into the reader's buffer,
+  // corrupting the elementary stream (seen as macroblock corruption/tearing
+  // in decoded video).
+  return TRANSPORT_PACKET_SIZE - 4;
+}
