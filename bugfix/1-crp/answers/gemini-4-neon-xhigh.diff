+static bool isH264OrH265VclNal(Boolean isH265, uint8_t nalHeaderByte)
+{
+    if (!isH265)
+    {
+        uint8_t nalType = nalHeaderByte & 0x1F;
+        return nalType >= 1 && nalType <= 5;
+    }
+    else
+    {
+        uint8_t nalType = (nalHeaderByte & 0x7E) >> 1;
+        return nalType <= 31;
+    }
+}
+
+static bool containsH264OrH265VclNal(Boolean isH265, const uint8_t* data, unsigned size)
+{
+    unsigned i = 0;
+    while (i + 3 < size)
+    {
+        unsigned scLen = 0;
+        if (i + 4 <= size && data[i] == 0x00 && data[i + 1] == 0x00 && data[i + 2] == 0x00 && data[i + 3] == 0x01)
+            scLen = 4;
+        else if (data[i] == 0x00 && data[i + 1] == 0x00 && data[i + 2] == 0x01)
+            scLen = 3;
+
+        if (scLen > 0)
+        {
+            unsigned nalPos = i + scLen;
+            if (nalPos < size && isH264OrH265VclNal(isH265, data[nalPos]))
+                return true;
+            i = nalPos;
+        }
+        else
+        {
+            i++;
+        }
+    }
+    return false;
+}
+
+static bool isH264OrH265NonVclAuStart(Boolean isH265, const uint8_t* nalu, unsigned size)
+{
+    if (size == 0)
+        return false;
+    if (!isH265)
+    {
+        uint8_t nalType = nalu[0] & 0x1F;
+        return (nalType >= 6 && nalType <= 9) || (nalType >= 14 && nalType <= 18);
+    }
+    else
+    {
+        uint8_t nalType = (nalu[0] & 0x7E) >> 1;
+        return (nalType >= 32 && nalType <= 35) || nalType == 39 ||
+               (nalType >= 41 && nalType <= 44) || (nalType >= 48 && nalType <= 55);
+    }
+}
+
+static bool isH264OrH265VclAuStart(Boolean isH265, const uint8_t* nalu, unsigned size)
+{
+    if (size == 0)
+        return false;
+    if (!isH265)
+    {
+        uint8_t nalType = nalu[0] & 0x1F;
+        if (nalType == 1 || nalType == 2 || nalType == 5)
+            return size >= 2 && (nalu[1] & 0x80) != 0; // first_mb_in_slice == 0
+        return false;
+    }
+    else
+    {
+        uint8_t nalType = (nalu[0] & 0x7E) >> 1;
+        if (nalType <= 31)
+            return size >= 3 && (nalu[2] & 0x80) != 0; // first_slice_segment_in_pic_flag == 1
+        return false;
+    }
+}
