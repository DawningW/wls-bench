+// Scan the packet's NAL units to check whether it contains a VCL NAL unit.
+// Packets without any VCL NAL unit (only SPS/PPS/AUD/SEI etc.) produce no
+// frame from the decoder, which must not be treated as a decode error.
+static bool packetHasVclNal(AVPacket* pkt, bool isH265)
+{
+    int offset = 0;
+    int size = 0;
+    int markerSize = 0;
+    while (extractH264Or5Frame(pkt, offset, size, markerSize))
+    {
+        int nalType;
+        if (isH265)
+            nalType = (pkt->data[offset + markerSize] & 0x7E) >> 1;
+        else
+            nalType = pkt->data[offset + markerSize] & 0x1F;
+        if (isH265 ? nalType <= 31 : (nalType >= 1 && nalType <= 5))
+            return true;
+        if (size <= 0)
+            break;
+    }
+    return false;
+}
