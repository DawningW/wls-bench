 #include "MPEG2TransportStreamParser.hh"
 
+#if CRP_MODIFY
+unsigned MPEG2TransportStreamDemuxedTrack::maxFrameSize() const {
+  // One 'frame' delivered by this source is (at most) the payload of one
+  // Transport Packet. Reporting this lets downstream StreamParsers swap
+  // their banks early enough that every delivery fits; without it, a
+  // delivery into a nearly-full bank got truncated and its tail skipped,
+  // losing bytes and corrupting the elementary stream.
+  return 188; // MPEG Transport Packet size (>= any TP payload, i.e. 184)
+}
+#endif
