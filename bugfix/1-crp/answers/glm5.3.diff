+#if CRP_MODIFY
+  virtual unsigned maxFrameSize() const;
+      // Returns the maximum size that a 'frame' (one Transport Packet's
+      // payload) can be.  Downstream StreamParsers use this to make sure
+      // their banks always have room for a complete delivery - otherwise
+      // the delivering parser would truncate (and silently drop) the tail
+      // of Transport Packet payloads whenever the reader's bank was nearly
+      // full, corrupting the elementary stream (missing 4..180 bytes per
+      // bank fill).
+#endif
